# ===============================================================
# KubeSentra configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# ===============================================================

# --- Application ---
APP_NAME=KubeSentra
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8547

# --- Database (docker compose service: postgres) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=kubesentra
POSTGRES_USER=kubesentra
POSTGRES_PASSWORD=kubesentra_dev

# --- Later phases (documented early; consumed when implemented) ---
# LLM provider interface (Phase 4/5, agent/llm.py):
# LLM_PROVIDER=openai|anthropic|ollama
# LLM_PRIMARY_MODEL=
# LLM_CHEAP_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=          # optional, for OpenAI-compatible endpoints
#
# Langfuse tracing (Phase 4):
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
#
# Kubernetes laboratory (Phase 2):
# KUBESENTRA_APP_NAMESPACE=boutique
